def batch(+d: Nat, +i: U32, +offset: U32) -> Answers:
  match d:
    case 0n:
      answer(position(U32.and(U32.add(i, offset), 1023)))
    case 1n+p:
      a b = batch(p, U32.shl(i), offset) batch(p, U32.inc(U32.shl(i)), offset)
      Both{a, b}

def output(a: Answers, tail: String) -> String:
  match a:
    case Answer{v}: U32.show(v) ++ "\n" ++ tail
    case Both{a, b}: output(a, output(b, tail))

def emit(a: Answers, start: Nat) -> IO(Unit):
  do IO<Unit>:
    end : Nat <- IO.now()
    Unit <- IO.print(output(a, "END"))
    done : Nat <- IO.now()
    IO.print_err("PHASE_MS " ++ Nat.show(start) ++ " " ++ Nat.show(end) ++ " " ++ Nat.show(done))

def repeat(+n: Nat) -> IO(Unit):
  match n:
    case 0n: IO.pure(Unit, Unit{})
    case 1n+p:
      do IO<Unit>:
        start : Nat <- IO.now()
        Unit <- emit(batch!(19n, 0, U32.and(U32.add(U32.from_nat(p), 1004), 1023)), start)
        repeat(p)

def main() -> IO(Unit):
  do IO<Unit>:
    Unit <- IO.print("READY")
    repeat(1n)
