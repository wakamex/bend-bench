+#if DEVICE
+// Keep the transposed fixed stack until a lane needs more. A spill grows
+// geometrically in the ordinary heap; only that lane pays for the space.
+typedef struct {
+  Stk base;
+  int64_t step;
+  u64 cap;
+  Loc loc;
+} Stack;
+
+INLINE bool stack_room(Env e, THR Stack* s, THR Stk* sp, u32 n) {
+  u64 used = *sp - s->base;
+  if (used + (u64)n * s->step <= s->cap * s->step) {
+    return true;
+  }
+  used /= s->step;
+  if (used + n > (1ull << 31)) {
+    err_post(e.mem, ERR_HEAP);
+    return false;
+  }
+  Cls cls = cls_fit((u32)(used + n));
+  Loc loc = heap_alloc(e, cls);
+  if (err_seen(e.mem)) {
+    return false;
+  }
+  for (u64 i = 0; i < used; i += 1) {
+    e.mem[loc + i] = s->base[i * s->step];
+  }
+  if (s->loc) {
+    heap_free(e, cls_fit((u32)s->cap), s->loc);
+  }
+  s->base = e.mem + loc;
+  s->step = 1;
+  s->cap  = 1ull << cls;
+  s->loc  = loc;
+  *sp = s->base + used;
+  return true;
+}
