diff --git a/tests/run/gpu_stack_boxed.bend b/tests/run/gpu_stack_boxed.bend
new file mode 100644
index 0000000..996454e
--- /dev/null
+++ b/tests/run/gpu_stack_boxed.bend
@@ -0,0 +1,31 @@
+# Heap-owned arrays survive stack relocation and are consumed on unwind.
+# Repeated independent calls also exercise reuse of returned spill blocks.
+import Base
+
+def leaf(+x: U32) -> U32:
+  U32.xor(U32.xor(x, 12345), 12345)
+
+def read(r: Array<U32> & U32, n: U32) -> U32:
+  (a, x) = r
+  U32.add(x, n)
+
+def finish(a: Array<U32>, n: U32) -> U32:
+  read(a[0], n)
+
+def deep(n: Nat, +x: U32) -> U32:
+  match n:
+    case 0n: x
+    case 1n+p:
+      a = [x : U32*1n]
+      left right = deep(p, U32.add(x, 1)) leaf(0)
+      finish(a, U32.add(left, right))
+
+def repeat(n: Nat, acc: U32) -> U32:
+  match n:
+    case 0n: acc
+    case 1n+p: repeat(p, U32.add(acc, deep(U32.to_nat(4096), 1)))
+
+def main() -> IO(Unit):
+  IO.print(U32.show(repeat!(8n, 0)))
+
+#|67158024
diff --git a/tests/run/gpu_stack_spill.bend b/tests/run/gpu_stack_spill.bend
new file mode 100644
index 0000000..67a6044
--- /dev/null
+++ b/tests/run/gpu_stack_spill.bend
@@ -0,0 +1,25 @@
+# Non-tail recursion must outgrow the fixed GPU lane stack, preserve
+# every held word, unwind, and return through a parallel join.
+import Base
+
+def leaf(+x: U32) -> U32:
+  U32.xor(U32.xor(x, 12345), 12345)
+
+def deep(n: Nat, +x: U32) -> U32:
+  match n:
+    case 0n: x
+    case 1n+p:
+      a b = deep(p, U32.add(x, 1)) leaf(x)
+      U32.add(a, b)
+
+def batch(+d: Nat, +n: Nat) -> U32:
+  match d:
+    case 0n: deep(n, 1)
+    case 1n+p:
+      a b = batch(p, n) batch(p, n)
+      U32.add(a, b)
+
+def main() -> IO(Unit):
+  IO.print(U32.show(batch!(4n, U32.to_nat(8192))))
+
+#|537067536
